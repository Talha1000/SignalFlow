# ==============================================================================
# SignalFlow Enterprise Environment Configuration Template
# ==============================================================================

# Database Connectivity (PostgreSQL / Supabase Free Tier compatible)
DATABASE_URL="postgresql://postgres:password@localhost:5432/signalflow?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/signalflow?schema=public"

# Session & Security
# Generated using: openssl rand -base64 32
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-32-chars-min"

# Demo Mode Toggle
# When "false" (recommended for production), demo login routes are disabled.
DEMO_MODE="false"

# AI Integration (Google Gemini - Free Tier compatible)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS Security (Comma-separated allowed origins, e.g. https://yourdomain.com)
ALLOWED_ORIGINS="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
